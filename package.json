{
  "name": "syneva",
  "version": "0.7.4",
  "description": "An integrated review environment (IRE) for code you didn't write by hand — review a git diff in the browser, then hand a structured review back to your coding agent.",
  "keywords": [
    "git",
    "diff",
    "code-review",
    "review",
    "coding-agent",
    "ai",
    "cli",
    "pi-package"
  ],
  "homepage": "https://github.com/walid-mos/syneva#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walid-mos/syneva.git"
  },
  "bugs": {
    "url": "https://github.com/walid-mos/syneva/issues"
  },
  "author": "Walid Mostefaoui",
  "contributors": [
    "Yusuf Mansur Özer"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24"
    }
  },
  "pi": {
    "extensions": [
      "extensions"
    ],
    "skills": [
      "skills/syneva"
    ],
    "prompts": [
      "prompts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "bin": {
    "syneva": "./dist/cli.js"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/build-ui.mjs --watch & tsx src/cli.ts",
    "build": "tsc && tsc -p tsconfig.ui.json && node scripts/build-ui.mjs && cp src/ui/index.html dist/index.html",
    "start": "node dist/cli.js",
    "check": "tsc --noEmit && tsc -p tsconfig.check.json && tsc -p tsconfig.ui.json",
    "lint": "oxlint --deny-warnings",
    "lint:types": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "perf-smoke": "node benchmarks/perf-smoke.mjs",
    "bench": "node benchmarks/bench-fixtures.mjs && node benchmarks/browser-bench.mjs",
    "prepack": "pnpm build",
    "release": "pnpm lint && pnpm lint:types && pnpm format:check && pnpm check && pnpm test && pnpm build && changelogen --release --push",
    "postinstall": "pnpm build"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@nextnode-solutions/standards": "1.24.0",
    "@types/alpinejs": "^3.13.11",
    "@types/alpinejs__persist": "^3.13.4",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "esbuild": "^0.28.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "@pierre/diffs": "1.4.3",
    "@shikijs/markdown-it": "^4.2.0",
    "alpinejs": "^3.15.12",
    "dompurify": "^3.4.8",
    "markdown-it": "^14.2.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "shiki": "^4.2.0",
    "typebox": "^1.3.30"
  }
}
