{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"noEmit": true,
		"declaration": false
		// The frontend-only layer aliases (FSD) are declared once in tsconfig.json's
		// "paths": app -> pages ->
		// widgets -> features -> entities -> shared, plus the neutral contracts sink.
		// Enforced here by moduleResolution=bundler and by oxlint's layer rules.
	},
	// The whole browser world: it imports modules through bundler-style specifiers,
	// so it cannot be checked in the NodeNext worlds.
	"include": ["src/frontend/**/*.ts"],
	// Drop the inherited emit excludes: they would hide every file from this world.
	"exclude": []
}
