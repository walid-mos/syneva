{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"types": ["node"],
		// Frontend layer aliases, shared with tsconfig.ui.json. The backend itself stays
		// on relative .js imports.
		"paths": {
			"@app/*": ["./src/frontend/app/*"],
			"@pages/*": ["./src/frontend/pages/*"],
			"@widgets/*": ["./src/frontend/widgets/*"],
			"@features/*": ["./src/frontend/features/*"],
			"@entities/*": ["./src/frontend/entities/*"],
			"@shared/*": ["./src/frontend/shared/*"],
			"@contracts/*": ["./src/contracts/*"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/frontend/**"]
}
