{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"rootDir": "."
	},
	// One noEmit pass for every NodeNext-checked file that never ships in dist:
	// backend tests, the harness extension module, and the lint/format configs.
	// The frontend stays out entirely - its tests import frontend modules through
	// bundler-style specifiers, so they are checked by tsconfig.ui.json in the bundler world.
	"include": [
		"src/**/*.test.ts",
		"extension/**/*.ts",
		"oxlint.config.ts",
		"oxfmt.config.ts"
	],
	// Keep the inherited frontend exclusion and drop the test exclusion.
	"exclude": ["src/frontend/**"]
}
